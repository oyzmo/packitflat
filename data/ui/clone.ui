<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.12"/>
  <requires lib="libadwaita" version="1.5"/>

  <template class="PifClone" parent="AdwDialog">
    <property name="title" translatable="yes">Start from a Git address</property>
    <property name="content-width">600</property>
    <property name="content-height">520</property>
    <property name="child">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar"/>
        </child>

        <property name="content">
          <object class="GtkStack" id="stage">
            <property name="transition-type">crossfade</property>

            <child>
              <object class="GtkStackPage">
                <property name="name">form</property>
                <property name="child">
                  <object class="AdwPreferencesPage">
                    <child>
                      <object class="AdwPreferencesGroup">
                        <property name="title" translatable="yes">Where is the code?</property>
                        <property name="description" translatable="yes">The code is copied to this computer once so the app can look at it — what language it's in, what it's called, what it needs. The manifest then points at the address, not at the copy, so anyone can build it.</property>
                        <child>
                          <object class="AdwActionRow">
                            <property name="title" translatable="yes">Address</property>
                            <property name="subtitle" translatable="yes">The repository's page, as it appears in your browser.</property>
                            <property name="subtitle-lines">0</property>
                            <child type="suffix">
                              <object class="GtkEntry" id="url_entry">
                                <property name="valign">center</property>
                                <property name="hexpand">True</property>
                                <property name="width-chars">24</property>
                                <property name="placeholder-text">https://github.com/someone/project</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwActionRow" id="url_status">
                            <property name="visible">False</property>
                            <property name="title-lines">0</property>
                            <property name="subtitle-lines">0</property>
                            <child type="prefix">
                              <object class="GtkImage" id="url_icon">
                                <property name="icon-name">dialog-warning-symbolic</property>
                              </object>
                            </child>
                            <child type="suffix">
                              <object class="GtkButton" id="url_fix_button">
                                <property name="visible">False</property>
                                <property name="valign">center</property>
                                <property name="label" translatable="yes">Use that one</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwActionRow">
                            <property name="title" translatable="yes">Version</property>
                            <property name="subtitle" translatable="yes">A tag or a branch, if you want a particular one. Leave it empty to take whatever is current — either way the exact revision is written into the manifest.</property>
                            <property name="subtitle-lines">0</property>
                            <child type="suffix">
                              <object class="GtkEntry" id="version_entry">
                                <property name="valign">center</property>
                                <property name="hexpand">True</property>
                                <property name="width-chars">14</property>
                                <property name="placeholder-text">v1.2.0</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>

                    <child>
                      <object class="AdwPreferencesGroup">
                        <property name="title" translatable="yes">Where should it go?</property>
                        <child>
                          <object class="AdwActionRow" id="folder_row">
                            <property name="title" translatable="yes">Folder</property>
                            <property name="subtitle-lines">0</property>
                            <child type="suffix">
                              <object class="GtkButton" id="folder_button">
                                <property name="valign">center</property>
                                <property name="label" translatable="yes">Choose…</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>

                    <child>
                      <object class="AdwPreferencesGroup">
                        <child>
                          <object class="GtkButton" id="clone_button">
                            <property name="halign">center</property>
                            <property name="sensitive">False</property>
                            <property name="label" translatable="yes">Get the code</property>
                            <style>
                              <class name="suggested-action"/>
                              <class name="pill"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>

            <child>
              <object class="GtkStackPage">
                <property name="name">working</property>
                <property name="child">
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">12</property>
                    <property name="margin-start">18</property>
                    <property name="margin-end">18</property>
                    <property name="margin-top">18</property>
                    <property name="margin-bottom">18</property>
                    <child>
                      <object class="GtkBox">
                        <property name="spacing">12</property>
                        <child>
                          <object class="GtkSpinner" id="spinner">
                            <property name="spinning">True</property>
                            <property name="valign">center</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="status_label">
                            <property name="hexpand">True</property>
                            <property name="halign">start</property>
                            <property name="wrap">True</property>
                            <property name="label" translatable="yes">Fetching the code…</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkScrolledWindow">
                        <property name="vexpand">True</property>
                        <style>
                          <class name="card"/>
                        </style>
                        <property name="child">
                          <object class="GtkTextView" id="log_view">
                            <property name="editable">False</property>
                            <property name="monospace">True</property>
                            <property name="top-margin">10</property>
                            <property name="bottom-margin">10</property>
                            <property name="left-margin">10</property>
                            <property name="right-margin">10</property>
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>

            <child>
              <object class="GtkStackPage">
                <property name="name">failed</property>
                <property name="child">
                  <object class="AdwPreferencesPage">
                    <child>
                      <object class="AdwPreferencesGroup">
                        <child>
                          <object class="AdwActionRow" id="failure_row">
                            <property name="title-lines">0</property>
                            <property name="subtitle-lines">0</property>
                            <child type="prefix">
                              <object class="GtkImage">
                                <property name="icon-name">dialog-warning-symbolic</property>
                              </object>
                            </child>
                            <style>
                              <class name="note-warning"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwPreferencesGroup">
                        <child>
                          <object class="AdwExpanderRow">
                            <property name="title" translatable="yes">What git said</property>
                            <child>
                              <object class="GtkScrolledWindow">
                                <property name="height-request">200</property>
                                <property name="child">
                                  <object class="GtkTextView" id="failure_log_view">
                                    <property name="editable">False</property>
                                    <property name="monospace">True</property>
                                    <property name="top-margin">10</property>
                                    <property name="bottom-margin">10</property>
                                    <property name="left-margin">10</property>
                                    <property name="right-margin">10</property>
                                  </object>
                                </property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwPreferencesGroup">
                        <child>
                          <object class="GtkButton" id="again_button">
                            <property name="halign">center</property>
                            <property name="label" translatable="yes">Try again</property>
                            <style>
                              <class name="pill"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
