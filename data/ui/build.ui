<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.12"/>
  <requires lib="libadwaita" version="1.5"/>

  <template class="PifBuild" parent="AdwNavigationPage">
    <property name="tag">build</property>
    <property name="title" translatable="yes">Build it</property>
    <property name="child">
      <object class="AdwToolbarView">

        <child type="top">
          <object class="AdwHeaderBar">
            <property name="title-widget">
              <object class="AdwWindowTitle" id="page_title">
                <property name="title" translatable="yes">Build it</property>
              </object>
            </property>
            <child type="end">
              <object class="GtkButton" id="cancel_button">
                <property name="visible">False</property>
                <property name="label" translatable="yes">Stop</property>
                <style>
                  <class name="destructive-action"/>
                </style>
              </object>
            </child>
          </object>
        </child>

        <property name="content">
          <object class="GtkStack" id="stage">
            <property name="transition-type">crossfade</property>

            <!-- Before the build: what has to be true, and how to run it -->
            <child>
              <object class="GtkStackPage">
                <property name="name">ready</property>
                <property name="child">
                  <object class="AdwPreferencesPage">
                    <child>
                      <object class="AdwPreferencesGroup">
                        <property name="title" translatable="yes">What building does</property>
                        <property name="description" translatable="yes">It reads the manifest, downloads what your app is built against, compiles your code inside a sandbox, and produces something installable. The first build is slow; later ones reuse what was downloaded.</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwPreferencesGroup" id="checks_group">
                        <property name="title" translatable="yes">Before we start</property>
                        <child>
                          <object class="GtkListBox" id="checks_list">
                            <property name="selection-mode">none</property>
                            <style>
                              <class name="boxed-list"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwPreferencesGroup">
                        <property name="title" translatable="yes">How to build it</property>
                        <child>
                          <object class="GtkListBox" id="options_list">
                            <property name="selection-mode">none</property>
                            <style>
                              <class name="boxed-list"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwPreferencesGroup">
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">12</property>
                            <child>
                              <object class="GtkButton" id="build_button">
                                <property name="halign">center</property>
                                <property name="label" translatable="yes">Build it now</property>
                                <style>
                                  <class name="suggested-action"/>
                                  <class name="pill"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="AdwActionRow" id="command_row">
                                <property name="title" translatable="yes">Or run it yourself</property>
                                <property name="subtitle-lines">0</property>
                                <child type="suffix">
                                  <object class="GtkButton" id="terminal_button">
                                    <property name="visible">False</property>
                                    <property name="valign">center</property>
                                    <property name="label" translatable="yes">Open a terminal</property>
                                    <property name="tooltip-text" translatable="yes">Runs the same command in a terminal window, which stays open afterwards</property>
                                  </object>
                                </child>
                                <child type="suffix">
                                  <object class="GtkButton" id="copy_command_button">
                                    <property name="valign">center</property>
                                    <property name="icon-name">edit-copy-symbolic</property>
                                    <property name="tooltip-text" translatable="yes">Copy the command</property>
                                    <style>
                                      <class name="flat"/>
                                    </style>
                                  </object>
                                </child>
                                <style>
                                  <class name="card"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>

            <!-- While it runs: a sentence first, the log underneath -->
            <child>
              <object class="GtkStackPage">
                <property name="name">running</property>
                <property name="child">
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <child>
                      <object class="AdwBanner" id="status_banner">
                        <property name="revealed">True</property>
                        <property name="title" translatable="yes">Starting…</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox">
                        <property name="spacing">12</property>
                        <property name="margin-start">12</property>
                        <property name="margin-end">12</property>
                        <property name="margin-top">12</property>
                        <property name="margin-bottom">6</property>
                        <child>
                          <object class="GtkSpinner" id="spinner">
                            <property name="spinning">True</property>
                            <property name="valign">center</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkSearchEntry" id="log_search">
                            <property name="hexpand">True</property>
                            <property name="placeholder-text" translatable="yes">Find in the log</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkScrolledWindow" id="log_scroll">
                        <property name="vexpand">True</property>
                        <property name="margin-start">12</property>
                        <property name="margin-end">12</property>
                        <property name="margin-bottom">12</property>
                        <style>
                          <class name="card"/>
                        </style>
                        <property name="child">
                          <object class="GtkTextView" id="log_view">
                            <property name="editable">False</property>
                            <property name="monospace">True</property>
                            <property name="top-margin">10</property>
                            <property name="bottom-margin">10</property>
                            <property name="left-margin">10</property>
                            <property name="right-margin">10</property>
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>

            <!-- Afterwards, either way -->
            <child>
              <object class="GtkStackPage">
                <property name="name">finished</property>
                <property name="child">
                  <object class="AdwPreferencesPage">
                    <child>
                      <object class="AdwPreferencesGroup" id="outcome_group">
                        <child>
                          <object class="AdwActionRow" id="outcome_row">
                            <property name="title-lines">0</property>
                            <property name="subtitle-lines">0</property>
                            <child type="prefix">
                              <object class="GtkImage" id="outcome_icon">
                                <property name="icon-name">object-select-symbolic</property>
                              </object>
                            </child>
                            <child type="suffix">
                              <object class="GtkButton" id="fix_button">
                                <property name="visible">False</property>
                                <property name="valign">center</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>

                    <child>
                      <object class="AdwPreferencesGroup" id="actions_group">
                        <property name="title" translatable="yes">What now?</property>
                        <property name="visible">False</property>
                        <child>
                          <object class="GtkListBox" id="actions_list">
                            <property name="selection-mode">none</property>
                            <style>
                              <class name="boxed-list"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>

                    <child>
                      <object class="AdwPreferencesGroup">
                        <child>
                          <object class="AdwExpanderRow" id="log_expander">
                            <property name="title" translatable="yes">The whole log</property>
                            <property name="subtitle" translatable="yes">Everything the build printed, in order.</property>
                            <child type="action">
                              <object class="GtkButton" id="copy_log_button">
                                <property name="valign">center</property>
                                <property name="label" translatable="yes">Copy</property>
                                <style>
                                  <class name="flat"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkScrolledWindow">
                                <property name="height-request">320</property>
                                <property name="child">
                                  <object class="GtkTextView" id="full_log_view">
                                    <property name="editable">False</property>
                                    <property name="monospace">True</property>
                                    <property name="top-margin">10</property>
                                    <property name="bottom-margin">10</property>
                                    <property name="left-margin">10</property>
                                    <property name="right-margin">10</property>
                                  </object>
                                </property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>

                    <child>
                      <object class="AdwPreferencesGroup">
                        <child>
                          <object class="GtkButton" id="again_button">
                            <property name="halign">center</property>
                            <property name="label" translatable="yes">Build it again</property>
                            <style>
                              <class name="pill"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
